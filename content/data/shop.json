{
  // The meta-progression's shop (phase 6.2). Coins come from the runs (all of them, won or lost, as in Vampire
  // Survivors) and from the missions. Characters' prices are in characters.json ("unlock").
  "version": 1,
  "pokemon": {
    // A character's secondary move, then its special: "base" + "share" × the character's price (rounded to 50).
    // Characters not sold in the shop (Pikachu, mission rewards, legendaries) count as "referencePrice".
    "referencePrice": 600,
    "secondary": { "base": 200, "share": 0.5 },
    "special": { "base": 600, "share": 1.0 },
    // Training: five grades per stat, grade N costs N × "gradePrice". The icons are the games' vitamins.
    "maxGrade": 5,
    "gradePrice": 100,
    "stats": [
      { "stat": "Hp", "nameIt": "PS", "icon": "hp-up", "perGrade": { "maxHpPercent": 0.04 } },
      { "stat": "Attack", "nameIt": "Attacco", "icon": "protein", "perGrade": { "physicalPowerPercent": 0.03 } },
      { "stat": "Defense", "nameIt": "Difesa", "icon": "iron", "perGrade": { "physicalResistPercent": 0.025 } },
      { "stat": "SpAttack", "nameIt": "Attacco Sp.", "icon": "calcium", "perGrade": { "specialPowerPercent": 0.03 } },
      { "stat": "SpDefense", "nameIt": "Difesa Sp.", "icon": "zinc", "perGrade": { "specialResistPercent": 0.025 } },
      { "stat": "Speed", "nameIt": "Velocità", "icon": "carbos", "perGrade": { "moveSpeedPercent": 0.02 } }
    ]
  },
  "trainers": {
    // Like the PowerUps of Vampire Survivors: grade N costs N × "gradePrice", and every grade owned on any trainer makes
    // the next ones "markupPerGrade" dearer. A refund gives back every coin spent on that trainer.
    "maxGrade": 5,
    "gradePrice": 200,
    "markupPerGrade": 0.1,
    // Each grade: passive bonuses (and the boost to the trainer's type) 20% stronger, the active ability's cooldown 6% shorter.
    "passivePerGrade": 0.2,
    "cooldownPerGrade": 0.06
  },
  // Upgrades for every run, bought once per grade ("prices" in order). "medals": gym leaders beaten in a challenge that
  // each grade needs (the Medaglie of the design). A refund gives back every coin spent on them.
  "upgrades": [
    { "id": "sesto-slot", "nameIt": "Sesto slot", "icon": "pp-max", "kind": "MoveSlot", "prices": [ 5000 ],
      "descriptionIt": "Un sesto slot per le mosse in ogni partita." },
    { "id": "fortuna", "nameIt": "Fortuna", "icon": "kings-rock", "kind": "Choices", "prices": [ 3000 ],
      "descriptionIt": "Ogni level-up offre quattro carte invece di tre." },
    { "id": "rilancio", "nameIt": "Rilancio", "kind": "Rerolls", "prices": [ 400, 800, 1200 ], "medals": [ 1, 3, 6 ],
      "descriptionIt": "Un Rilancio in più in ogni partita." },
    { "id": "salta", "nameIt": "Salta", "kind": "Skips", "prices": [ 300, 600, 900 ], "medals": [ 1, 3, 6 ],
      "descriptionIt": "Un Salta in più in ogni partita." },
    { "id": "bandisci", "nameIt": "Bandisci", "kind": "Banishes", "prices": [ 500, 1000, 1500 ], "medals": [ 2, 4, 8 ],
      "descriptionIt": "Un Bandisci in più in ogni partita." },
    { "id": "avidita", "nameIt": "Avidità", "icon": "amulet-coin", "kind": "Bonus", "prices": [ 200, 400, 600, 800, 1000 ],
      "perGrade": { "coinPercent": 0.1 }, "descriptionIt": "Monete raccolte +10% per grado." },
    { "id": "crescita", "nameIt": "Crescita", "icon": "lucky-egg", "kind": "Bonus", "prices": [ 300, 600, 900, 1200, 1500 ],
      "perGrade": { "growthPercent": 0.03 }, "descriptionIt": "Esperienza +3% per grado." },
    { "id": "magnete", "nameIt": "Magnete", "icon": "magnet", "kind": "Bonus", "prices": [ 150, 300, 450 ],
      "perGrade": { "pickupRadiusPercent": 0.1 }, "descriptionIt": "Raggio di raccolta +10% per grado." },
    // Added after the playtest of 2026-10-27 ("i potenziamenti sono troppo pochi"): the rest of Vampire Survivors'
    // PowerUps, weaker than the held items of the same kind (a grade is about a third of an item's level).
    { "id": "potenza", "nameIt": "Potenza", "icon": "black-belt", "kind": "Bonus", "prices": [ 300, 600, 900, 1200, 1500 ],
      "perGrade": { "physicalPowerPercent": 0.03, "specialPowerPercent": 0.03 }, "descriptionIt": "Mosse fisiche e speciali +3% per grado." },
    { "id": "corazza", "nameIt": "Corazza", "icon": "hard-stone", "kind": "Bonus", "prices": [ 400, 800, 1200 ],
      "perGrade": { "physicalResistPercent": 0.02, "specialResistPercent": 0.02 }, "descriptionIt": "Danni da tutti i nemici -2% per grado." },
    { "id": "vitalita", "nameIt": "Vitalità", "icon": "sitrus-berry", "kind": "Bonus", "prices": [ 250, 500, 750, 1000, 1250 ],
      "perGrade": { "maxHpPercent": 0.05 }, "descriptionIt": "PS massimi +5% per grado." },
    { "id": "ristoro", "nameIt": "Ristoro", "icon": "leftovers", "kind": "Bonus", "prices": [ 300, 600, 900 ],
      "perGrade": { "regenPerSecond": 0.05 }, "descriptionIt": "Recuperi 0,05 PS al secondo per grado." },
    { "id": "ricarica", "nameIt": "Ricarica", "icon": "quick-claw", "kind": "Bonus", "prices": [ 900, 1800 ],
      "perGrade": { "cooldownReductionPercent": 0.025 }, "descriptionIt": "Ricarica delle mosse -2,5% per grado." },
    { "id": "ampiezza", "nameIt": "Ampiezza", "icon": "wide-lens", "kind": "Bonus", "prices": [ 600, 1200 ],
      "perGrade": { "areaPercent": 0.05 }, "descriptionIt": "Area delle mosse +5% per grado." },
    { "id": "durata", "nameIt": "Durata", "icon": "light-clay", "kind": "Bonus", "prices": [ 400, 800 ],
      "perGrade": { "durationPercent": 0.05 }, "descriptionIt": "Le mosse che restano in campo durano +5% per grado." },
    { "id": "slancio", "nameIt": "Slancio", "icon": "sharp-beak", "kind": "Bonus", "prices": [ 200, 400 ],
      "perGrade": { "projectileSpeedPercent": 0.1 }, "descriptionIt": "Velocità dei colpi +10% per grado." },
    { "id": "scatto", "nameIt": "Scatto", "icon": "silk-scarf", "kind": "Bonus", "prices": [ 300, 600 ],
      "perGrade": { "moveSpeedPercent": 0.03 }, "descriptionIt": "Velocità di movimento +3% per grado." },
    { "id": "precisione", "nameIt": "Precisione", "icon": "scope-lens", "kind": "Bonus", "prices": [ 400, 800, 1200 ],
      "perGrade": { "critChance": 0.02 }, "descriptionIt": "Brutti colpi +2% per grado." },
    { "id": "eco", "nameIt": "Eco", "icon": "metronome", "kind": "Bonus", "prices": [ 6000 ], "medals": [ 4 ],
      "perGrade": { "amountBonus": 1 }, "descriptionIt": "Ogni mossa lancia un colpo in più, in ogni partita." },
    { "id": "seconda-vita", "nameIt": "Seconda vita", "icon": "focus-sash", "kind": "Bonus", "prices": [ 4000 ], "medals": [ 2 ],
      "perGrade": { "revives": 1 }, "descriptionIt": "Una volta per partita, quando vai KO torni in piedi con metà dei PS." }
  ]
}
