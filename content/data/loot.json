{
  "version": 1,

  // Phase 3.5: breakables, things on the ground, shinies.
  // The map is cut into square cells "cellSize" px wide; each cell holds tall grass with chance grass.chance, else a
  // boulder with chance rock.chance, else nothing. The same cells come back when the player returns; broken ones do not.
  // "hp" is before the minute's growth (one hit cuts grass; boulders take a few). "dropChance": chance to leave an item.
  "cellSize": 100,
  "grass": { "chance": 0.3, "hp": 1, "defense": 10, "dropChance": 0.15 },
  "rock": { "chance": 0.08, "hp": 40, "defense": 80, "dropChance": 0.7 },

  // What a broken prop leaves, by weight:
  // coin (a few coins), nugget (Pepita: more coins), potion (Pozione: heals), rareCandy (Caramella Rara: +1 level),
  // repel (Repellente: every regular enemy on screen faints), expShare (Condividi Esp.: every gem flies to you).
  "drops": [
    { "kind": "coin", "weight": 50 },
    { "kind": "potion", "weight": 16 },
    { "kind": "nugget", "weight": 10 },
    { "kind": "expShare", "weight": 8 },
    { "kind": "rareCandy", "weight": 8 },
    { "kind": "repel", "weight": 6 }
  ],

  // Now and then a regular Pokémon leaves a coin; rarely a wave sends a shiny one (10× PS, harder hits, 5× experience; it leaves a big nugget and a held item).
  // Playtest of 2026-10-27: 0.004 gave 74 shinies in 5 runs (15 a run) and their big nuggets were 70% of the coins.
  // At 0.0008 a run of 3–4 thousand KO meets two or three.
  "enemyCoinChance": 0.01,
  "shinyChance": 0.0008,

  // Phase 3.6: now and then a defeated Pokémon leaves a Baccarancia that restores "foodHeal" PS, like Vampire Survivors'
  // floor chicken. With about a thousand KO by minute 5, 0.3% gives three or four before then.
  "enemyFoodChance": 0.003,
  "foodHeal": 30,

  // Block 6: the coins go to the shop's bank, so they are worth 4× what they were (2, 10, 25): a run of five or six
  // minutes brings a few hundred, a whole level over a thousand.
  "coinValue": 8,
  "nuggetValue": 40,
  "bigNuggetValue": 100,

  // Share of the maximum PS a Pozione restores.
  "potionHeal": 0.3
}
